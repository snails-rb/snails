#!/bin/bash
# snails — the single CLI for consuming the shared runtime in an app tree.
#
# Consumers call one command instead of carrying per-app vendor scripts
# (the two `script/sync-shared-runtime.sh` copies were identical):
#
#   bin/snails sync [<app_root>] [--pins FILE] [--from-checkout] [--check] [--verbose]
#       Vendor the core into <app_root>/snails-core (the boot chain ships
#       with it), seed missing gen/* require-all files, and verify the
#       scaffold contract. Without `--pins` the nearest pins
#       file at or above <app_root> is the pin (walk-up discovery, bounded
#       by the directory holding .git). `--pins` reads SNALS_REV from the
#       file — a full 40-hex rev (the edge channel: content no release
#       names yet) or a vX.Y.Z release version (resolved to its tagged
#       commit) — and vendors the core FROM THAT REV — the pin declares the
#       content, so a checkout that has moved past it never blocks the
#       sync (and never leaks its own content in). An installed dist (no
#       checkout) resolves the same pin through the published dist
#       releases: the dist's own rev, `~/.cache/snails/dist/<rev>`, then a
#       verified download. `--from-checkout` confirms the checkout source;
#       the pins file must declare `SNALS_SOURCE="checkout"` (a tree
#       without a pin rev keeps the pre-declaration behavior). The same
#       pins file's SPINEL_REV materializes
#       the pinned spinel toolchain next to it (<pins dir>/.spinel/toolchain)
#       from the cache, a matching PATH install, or a source build.
#       `--check` writes nothing: it syncs a copy, diffs the vendored
#       core, and reports a missing/stale toolchain.
#       Progress prints on stderr; the result is one stdout line naming
#       the vendored revs. `--verbose` adds the detail the default
#       output omits — the drift list under `--check`, the internal
#       paths (dist cache, scaffold source) otherwise.
#
#   bin/snails new <dir> [--database=sqlite|postgresql] [--scaffold]
#       Create a project skeleton from the scaffolds — the server entry,
#       app seeds, /up health controller, and the scaffold/new template
#       (config, main.rb, spin.toml, pins.toml, bin/<name>.rb + the
#       bin/test·bin/dev wrappers; `__X__` placeholders are substituted)
#       — and vendor the core. The result serves
#       `GET /up`. `--database` stamps the app's database configuration
#       (config/database.rb; default: sqlite; postgresql selects
#       `snails-core/database/postgresql`). `--scaffold`
#       overlays the full API-mode template (scaffold/full: posts +
#       nested comments JSON resources, harness CRUD cases) for a full app
#       that exercises DB + harness end to end. `new` stamps the
#       adapter's DDL as the first migration (a UTC version in
#       db/migrate/). The snapshot `db/schema.sql` is generated by
#       `snails migrate dump` (printed as a next step), never written
#       by `new`.
#
#   bin/snails pins-path [<app_root>]
#       Print where the pins file is: the nearest pins.toml at or above
#       <app_root> (default the current directory), bounded by the
#       directory holding .git. The pins file sits at the app root, so a
#       start inside the app answers with that file. One stdout line; no
#       pins file is exit 1. The walk itself is cli/pins.sh — the same
#       resolution sync, verify-pins, and the engines use.
#
#   bin/snails verify-pin [rev|pins.toml] [--verbose]
#       Pin usability check: rev restores the core paths, plus a notice
#       when this checkout has moved past the pin (cli/verify-pin.sh;
#       --verbose lists the commits behind the notice).
#       In dist mode the check is publication — the rev's release must
#       exist (the dist's own rev is trivially usable). With no argument,
#       reads the pins file in the current directory.
#
#   bin/snails verify-pins [<app_root>] [--pins FILE] [--verbose]
#       The pin declaration gate for a consumer project: the pins file
#       (named by --pins, else discovered at or above <app_root>, default
#       the current directory) must declare a SNALS_REV this core restores
#       — a full 40-hex rev or a vX.Y.Z release version (resolved to its
#       tagged commit) — (verify-pin semantics, notices pass through)
#       and a SPINEL_REV
#       equal to the one declared at that SNALS_REV — the validated
#       (core rev, spinel rev) pair. The pinned rev's record decides, so
#       an older pair keeps verifying under a newer CLI; in dist mode the
#       record comes from this dist's own pin, the per-rev dist cache, or
#       the published pins file. App-owned files (CI wiring, docs) are
#       not this command's business.
#
#   bin/snails gen-require-all [<app_root>] [--check] [--verbose]
#       Regenerate the literal require lists spinel's AOT graph needs from
#       each gen/*.rb file's `# scan:` spec (content-gated writes; --check
#       only reports staleness, --verbose lists the stale files). The
#       generator is a core engine — a project
#       carries no copy of it (bin/test and bin/dev call this command).
#
#   bin/snails generate job_queue [<app_root>]     (alias: g)
#       Stamp the DB-backed job queue into an app tree: the migration
#       history (db/migrate/<UTC version>_create_snails_queue[.pg].sql —
#       the app's database configuration picks the variant) plus the
#       provisioning snapshot (db/schema.sql — regenerated by
#       `migrate dump` on both adapters; pg needs PG_URL for the
#       replay), then print the config/environment.rb
#       wiring lines (the queue adapter selection, and the retention
#       registration commented out — retention is opt-in). Already
#       present — a migration, or the tables in the snapshot — is a
#       one-line result that writes nothing.
#
#   bin/snails verify-scaffold [<app_root>]
#       Scaffold contract check (cli/verify-scaffold.sh).
#
#   bin/snails migrate <status|plan|apply|verify|check|dump> [--app DIR]
#                      [--database TARGET] [--verbose]
#       Schema migrations for an EXISTING database: db/migrate/
#       <version>_<name>[.<adapter>].sql — the version is a numeric
#       prefix (new files: UTC timestamp YYYYMMDDHHMMSS) — applied in
#       numeric version order and recorded in schema_migrations;
#       `dump` regenerates the snapshot (db/schema.sql — tables, indexes,
#       views) from those migration files — generated output, never
#       hand-edited — and `verify` proves the committed snapshot equals
#       that output; `check` exits 1 while any migration is pending (the
#       dev-server boot check, read-only). For pg, dump and verify
#       replay into a throwaway schema on the target and drop it on
#       exit.
#       (cli/migrate.sh — bash, executor = the adapter's own CLI).
#
#   bin/snails exec <command> [args...]
#       Run a command from the pinned toolchain: the nearest pins file at
#       or above $PWD decides which spinel build is materialized onto
#       PATH (cli/toolchain.sh) before exec — e.g.
#       `snails exec spin test test/x_test.rb`. Outside a pinned tree the
#       personal standalone install takes over ($SNAILS_SPINEL_HOME,
#       default ~/.local/lib/spinel; an empty value disables) — the
#       "project pins, otherwise the personal default" split, surfaced
#       to the shell by the spin/spinel shims. Every refusal (no pins
#       and no standalone, a command outside the toolchain) stays loud.
#
#   bin/snails install-shim [--bin-dir DIR]
#       Write/update the spin/spinel PATH shims — the interactive half of
#       the split `exec` implements: each shim delegates to `snails exec
#       <tool>`, so a pinned tree resolves its SPINEL_REV toolchain and
#       anything else falls back to the personal standalone install.
#       The body is the external file scaffold/shim/tool — copied
#       verbatim, never generated inline. Content-gated writes (a current
#       shim is untouched); the classic personal-install symlink
#       ($SNAILS_SPINEL_HOME, default ~/.local/lib/spinel) is replaced
#       with the binary left in place; any other existing file is refused
#       loudly.
#
# App-root commands (sync, harness, verify-scaffold, gen-*, generate, migrate) accept
# a missing app root: it resolves through cli/app-root.sh to the
# nearest directory at or above $PWD carrying config/database.rb — the
# pins file lives there too, so the app is the only thing to find. A
# start outside the app is not a resolution: pass the app root.
#
# The sync engine stays in cli/ (sync-runtime.sh + verify-scaffold.sh);
# this CLI is the stable entry point consumers use,
# so the engine can change without the consumer command changing.
set -euo pipefail

# Resolve this script's real path: install.sh links the CLI into a bin
# directory (`~/.local/bin/snails`), so the invoked path is not the tree
# the CLI serves. readlink -f is not everywhere (macOS), so the symlink
# chain is walked by hand.
SNAILS_SOURCE="${BASH_SOURCE[0]}"
while [[ -L $SNAILS_SOURCE ]]; do
  link_dir="$(cd "$(dirname "$SNAILS_SOURCE")" && pwd)"
  SNAILS_SOURCE="$(readlink "$SNAILS_SOURCE")"
  [[ $SNAILS_SOURCE == /* ]] || SNAILS_SOURCE="$link_dir/$SNAILS_SOURCE"
done
SNAILS_ROOT="$(cd "$(dirname "$SNAILS_SOURCE")/.." && pwd)"
# shellcheck source=cli/vendor-dir.sh
source "$SNAILS_ROOT/cli/vendor-dir.sh"

# An installed dist carries a REV file (written at publish time) and no
# git checkout of its own; a dev checkout has .git and no REV. The mode
# decides how a pin rev resolves: git restores it, a dist downloads the
# published dist release.
DIST_MODE=0
# `.git` may be a directory (checkout) or a file pointing at the real git
# dir (linked worktree); `-e` covers both, and a dist has neither.
if [[ -f $SNAILS_ROOT/REV && ! -e $SNAILS_ROOT/.git ]]; then
  DIST_MODE=1
fi

# App-root commands share one resolution rule (cli/app-root.sh): the
# nearest database configuration at or above $PWD. The same file backs
# the migrate engine.
# shellcheck source=cli/app-root.sh
source "$SNAILS_ROOT/cli/app-root.sh"

# The DB adapter detector is shared with the harness engines and the doctor
# command — one rule for reading config/database.rb.
# shellcheck source=cli/database-adapter.sh
source "$SNAILS_ROOT/cli/database-adapter.sh"

# Pins-file resolution is shared with the engines (cli/pins.sh): the walk
# that locates the file and the parser that reads one key from it.
# shellcheck source=cli/pins.sh
source "$SNAILS_ROOT/cli/pins.sh"

# Temp trees (pinned core copies, --check staging) removed on exit.
TMPDIRS=()
cleanup() {
  local d
  for d in ${TMPDIRS[@]+"${TMPDIRS[@]}"}; do rm -rf "$d"; done
}
trap cleanup EXIT

# Help text. The public surface is grouped by the task the reader is doing;
# internal commands surface only through `snails help --all`.
usage_overview() {
  cat <<'USAGE'
usage: snails <command> [options]

Common
  new           Create a project
  generate      Generate code (g)
  migrate       Manage schema migrations
  sync          Update the vendored runtime

Project
  pins          Check pin declarations or print the pins file
  doctor        Check the project and toolchain

Build and deploy
  build-image   Build the app image
  build-binary  Build the native binary on this host
  compose       Run Docker Compose

Toolchain
  exec          Run a command from the pinned toolchain
  install-shim  Install spin/spinel PATH shims

Help
  help [COMMAND]  Show help for a command
  version         Show the CLI version

Inside a project, bin/dev runs the server and bin/test runs the test suite.
Run 'snails help --all' for internal commands.
USAGE
}

usage_all() {
  usage_overview
  cat <<'USAGE'

Internal (used by build, CI, or the generated bin/ scripts)
  harness test|dev   Run the test gate or development server
  verify-pin         Check one pin revision
  verify-pins        Check the pin declaration (alias: pins check)
  pins-path          Print the pins file (alias: pins path)
  verify-scaffold    Check the scaffold contract
  gen-require-all    Regenerate gen/* require lists
  gen-route-helpers  Regenerate gen/route_helpers.rb
  gen-model-columns  Regenerate gen/model_columns.rb and .rbs
USAGE
}

# Kept as the overview entry point for the existing -h handlers.
usage() { usage_overview; }

help_new() {
  cat <<'HELP'
Usage: snails new <dir> [--database=sqlite|postgresql] [--scaffold]

Create a project skeleton that serves GET /up.

Options:
  --database=sqlite|postgresql  Database adapter (default: sqlite)
  --scaffold                   Add the posts and comments JSON API example

Examples:
  snails new demo
  snails new demo --database=postgresql --scaffold
HELP
}

help_generate() {
  cat <<'HELP'
Usage: snails generate <generator> [<app_root>]

Generate code into an app tree.

Generators:
  job_queue  Add the DB-backed job queue migration and wiring

Examples:
  snails generate job_queue
  snails g job_queue
HELP
}

help_generate_job_queue() {
  cat <<'HELP'
Usage: snails generate job_queue [<app_root>]

Add the DB-backed job queue migration and its db/schema.sql snapshot.
The command prints the config/environment.rb wiring; applying the
migration is a separate `snails migrate apply` step.
HELP
}

help_migrate() {
  cat <<'HELP'
Usage: snails migrate <status|plan|apply|verify|check|dump> [--app DIR] [--database TARGET] [--verbose]

Manage schema migrations for an existing database.

Commands:
  status   Show applied and pending migrations
  plan     Print the SQL of pending migrations
  apply    Apply pending migrations in order
  verify   Check the committed snapshot against the migration files
  dump     Regenerate db/schema.sql (tables, indexes, views) from the
           migration files — the snapshot is generated output
  check    Exit 1 while a migration is pending (read-only)

Options:
  --app DIR          App root (default: nearest config/database.rb above $PWD)
  --database TARGET  Database target (default: adapter env, then storage/development.sqlite3)
                     sqlite dump takes none (file-only); pg dump/verify
                     replay into a throwaway schema on this target
  --verbose          Print pending labels and the full repair command

Examples:
  snails migrate status
  snails migrate apply
HELP
}

help_migrate_sub() {
  case "$1" in
    status)
      cat <<'HELP'
Usage: snails migrate status [--app DIR] [--database TARGET] [--verbose]

Show applied and pending migrations, plus a ledger gap check.
HELP
      ;;
    plan)
      cat <<'HELP'
Usage: snails migrate plan [--app DIR] [--database TARGET] [--verbose]

Print the SQL of every pending migration (dry run).
HELP
      ;;
    apply)
      cat <<'HELP'
Usage: snails migrate apply [--app DIR] [--database TARGET] [--verbose]

Apply pending migrations in order and record each in the ledger.
HELP
      ;;
    verify)
      cat <<'HELP'
Usage: snails migrate verify [--app DIR] [--database TARGET] [--verbose]

Check that the committed snapshot equals what `migrate dump` regenerates
from the migration files. pg replays into a throwaway schema on the
target and drops it. --verbose adds the unified diff.
HELP
      ;;
    dump)
      cat <<'HELP'
Usage: snails migrate dump [--app DIR] [--database TARGET] [--verbose]

Regenerate db/schema.sql (tables, indexes, views) from db/migrate/*.sql.
The snapshot is generated output — edit the migration files, not the
snapshot. pg replays into a throwaway schema on the target
(--database or PG_URL) and drops it. --verbose lists what changed.
HELP
      ;;
    check)
      cat <<'HELP'
Usage: snails migrate check [--app DIR] [--database TARGET] [--verbose]

Exit 1 while any migration is pending (read-only, the dev boot check).
--verbose adds the pending labels and the full repair command.
HELP
      ;;
    *)
      return 1
      ;;
  esac
}

help_sync() {
  cat <<'HELP'
Usage: snails sync [<app_root>] [--pins FILE] [--from-checkout] [--check] [--skip-toolchain] [--verbose]

Vendor the runtime declared by pins.toml into <app_root>/snails-core/.

Options:
  --pins FILE        Read the pin from FILE (default: nearest pins.toml)
  --from-checkout    Vendor from the checkout; requires SNALS_SOURCE="checkout"
  --check            Check without writing
  --skip-toolchain   Do not install or check the pinned spinel toolchain
  --verbose          Print drift and internal paths

Examples:
  snails sync
  snails sync --check
HELP
}

help_pins() {
  cat <<'HELP'
Usage: snails pins <check|path> [<app_root>] [--pins FILE] [--verbose]

Check the project pin declaration or print the pins file.

Commands:
  check  Check SNALS_REV, SPINEL_REV, and that they form a validated pair
  path   Print the nearest pins.toml

Examples:
  snails pins check
  snails pins path
HELP
}

help_pins_check() {
  cat <<'HELP'
Usage: snails pins check [<app_root>] [--pins FILE] [--verbose]

Check that SNALS_REV is restorable and SPINEL_REV is the value declared
at that rev. --verbose adds the commit list behind a pin notice.
HELP
}

help_pins_path() {
  cat <<'HELP'
Usage: snails pins path [<app_root>]

Print the nearest pins.toml at or above <app_root>.
HELP
}

help_doctor() {
  cat <<'HELP'
Usage: snails doctor [<app_root>] [--verbose]

Check the CLI version, pin declaration, vendored runtime, toolchain,
environment, database target, and local clients. Exit 1 when a check fails.
HELP
}

