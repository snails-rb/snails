cmd_migrate() {
  if [[ $# -eq 0 || ${1:-} == -h || ${1:-} == --help ]]; then
    help_migrate
    exit 0
  fi
  case "$1" in
    status|plan|apply|verify|check|dump)
      if [[ ${2:-} == -h || ${2:-} == --help ]]; then
        help_migrate_sub "$1" || exit 2
        exit 0
      fi
      ;;
  esac
  bash "$SNAILS_ROOT/cli/migrate.sh" "$@"
}

# exec — run a command from the pins file's pinned toolchain. Discover
# the pins file upward from $PWD, materialize its SPINEL_REV toolchain,
# pin that absolute path on PATH, and exec. Outside a pinned tree the
# personal standalone install takes over (SNAILS_SPINEL_HOME, default
# ~/.local/lib/spinel; an empty value disables the fallback) — the
# "project pins, otherwise the personal default" shape, with the PATH
# shims (spin/spinel -> `snails exec …`) making it automatic in a shell.
# Every refusal (no pins and no standalone, a command outside the
# toolchain) stays loud.
cmd_exec() {
  local toolchain_pins toolchain_kit spinel_home
  [[ $# -ge 1 ]] || { echo "[snails] usage: snails exec <command> [args...]" >&2; exit 2; }
  # shellcheck source=toolchain.sh
  source "$SNAILS_ROOT/cli/toolchain.sh"
  toolchain_pins="$(pins_discover "$PWD")"
  if [[ -z $toolchain_pins ]]; then
    spinel_home="${SNAILS_SPINEL_HOME-$HOME/.local/lib/spinel}"
    if [[ -n $spinel_home && -x $spinel_home/$1 ]]; then
      echo "[snails] no pins file at or above $PWD — using the standalone spinel at $spinel_home" >&2
      exec "$spinel_home/$1" ${2+"${@:2}"}
    fi
    echo "[snails] no pins file at or above $PWD and no standalone spinel at ${spinel_home:-<disabled>}/$1 — install spinel or set SNAILS_SPINEL_HOME" >&2
    exit 1
  fi
  spinel_toolchain_ensure "$toolchain_pins" || exit 1
  toolchain_kit="$(spinel_toolchain_dir "$toolchain_pins")"
  export PATH="$toolchain_kit:$PATH"
  command -v "$1" >/dev/null || {
    echo "[snails] not in the pinned toolchain: $1 ($toolchain_kit)" >&2
    exit 1
  }
  exec "$@"
}

# install-shim — write/update the spin/spinel PATH shims: the interactive
# half of the split `exec` implements (a pinned tree resolves its
# SPINEL_REV toolchain; anything else falls back to the personal
# standalone install). The shim body is the external file
# scaffold/shim/tool, copied verbatim — never generated inline.
# Content-gated writes; the classic personal-install symlink is replaced
# with the binary left in the fallback home; any other existing file is
# refused loudly.
cmd_install_shim() {
  local bin_dir="${SNAILS_BIN_DIR:-$HOME/.local/bin}" spinel_home="${SNAILS_SPINEL_HOME-$HOME/.local/lib/spinel}" shim_source="$SNAILS_ROOT/scaffold/shim/tool"
  while (($#)); do
    case "$1" in
      --bin-dir) bin_dir="${2:-}"; shift 2 ;;
      -h|--help) help_for install-shim; exit 0 ;;
      *) echo "[snails] unknown flag: $1" >&2; exit 2 ;;
    esac
  done
  [[ -n $bin_dir ]] || { echo "[snails] --bin-dir needs a value" >&2; exit 2; }
  [[ -f $shim_source ]] || { echo "[snails] the shim body is missing from this CLI tree: $shim_source" >&2; exit 1; }
  mkdir -p "$bin_dir"
  local tool target want current tmp failed=0
  for tool in spin spinel; do
    target="$bin_dir/$tool"
    want="$(cat "$shim_source")"
    if [[ -L $target ]]; then
      if [[ "$(readlink "$target")" != "$spinel_home/$tool" ]]; then
        echo "[snails] refusing to replace $target — it links to $(readlink "$target")" >&2
        failed=1
        continue
      fi
      echo "[snails] replacing the personal-install symlink at $target" >&2
    elif [[ -e $target ]] && ! grep -q "snails shim — " "$target" 2>/dev/null; then
      echo "[snails] refusing to replace $target — not a snails shim (move it aside, or pass --bin-dir)" >&2
      failed=1
      continue
    fi
    current="$(cat "$target" 2>/dev/null || true)"
    if [[ $current == "$want" ]]; then
      echo "[snails] $target is already current" >&2
    else
      # Copy via a temp file: redirecting into a symlink would follow it
      # and clobber the fallback binary it points at.
      tmp="$target.tmp.$$"
      cp "$shim_source" "$tmp"
      chmod +x "$tmp"
      mv -f "$tmp" "$target"
      echo "[snails] wrote $target" >&2
    fi
  done
  if ((failed)); then
    exit 1
  fi
  echo "[snails] spin/spinel shims ready in $bin_dir (fallback: $spinel_home)"
}

# harness — the app-target runners live in the core engine tree as CLI
# engines (cli/harness-test.sh, cli/harness-dev.sh): the app
# tree carries no copy of them (a seeded copy drifts). <app_root> is the
# spin root — the directory holding harness/.
cmd_harness() {
  local action="${1:-}"
  case "$action" in
    test|dev) shift ;;
    -h|--help|"") help_harness; exit 0 ;;
    *) echo "[snails] usage: snails harness test|dev [<app_root>] [-- args]" >&2; exit 2 ;;
  esac
  if [[ ${1:-} == -h || ${1:-} == --help ]]; then
    help_harness_runner "$action" || exit 2
    exit 0
  fi
  local app_root="${1:-}"
  if [[ -z $app_root || $app_root == -* ]]; then
    # No positional app root: resolve one and leave the flags in "$@" for
    # the engine. A flag is never an app root.
    app_root="$(resolve_app_root '[snails]' '<app_root>')" || exit 2
  else
    shift
    # An explicit argument may be the repository root of a src/ layout.
    app_root="$(app_root_for "$app_root")"
  fi
  [[ -d "$app_root/harness" ]] || {
    echo "[snails] no harness/ under $app_root — the app target is seeded by 'snails sync' on scaffold trees" >&2
    exit 1
  }
  local engine="$SNAILS_ROOT/cli/harness-${action}.sh"
  [[ -f $engine ]] || { echo "[snails] engine missing: $engine" >&2; exit 1; }
  # exec so the engine — and the server binary it execs into — replaces
  # this process. Without it a caller that kills the wrapper PID reaps a
  # shell while the engine's server keeps the port forever (an orphan
  # listener later answers readiness probes meant for another app).
  SNAILS_CLI="$SNAILS_ROOT/bin/snails"
  export SNAILS_CLI
  exec bash "$engine" "$app_root" "$@"
}

# suggest_command <typo> — the closest public command by shared prefix. A
# small suggestion beats printing the whole command list after a typo.
suggest_command() {
  local input="$1" candidate
  for candidate in new generate g migrate sync pins doctor build-image build-binary compose exec install-shim help version; do
    case "$candidate" in
      "$input"*) printf '%s' "$candidate"; return 0 ;;
    esac
    case "$input" in
      "$candidate"*) printf '%s' "$candidate"; return 0 ;;
    esac
  done
  return 1
}

cmd_unknown() {
  local cmd="$1" suggestion=""
  case "$cmd" in
    dev)
      echo "[snails] dev is a project command — run bin/dev from the app root" >&2
      exit 2
      ;;
    test)
      echo "[snails] test is a project command — run bin/test from the app root" >&2
      exit 2
      ;;
  esac
  echo "[snails] unknown command: $cmd" >&2
  suggestion="$(suggest_command "$cmd")" || true
  if [[ -n $suggestion ]]; then
    echo "[snails] did you mean '$suggestion'? Run 'snails help' to see commands." >&2
  else
    echo "[snails] run 'snails help' to see commands." >&2
  fi
  exit 2
}

cmd="${1:-}"
if (($#)); then shift; fi

# Help flags are answered before any command resolves an app root or calls an
# engine, so `snails <command> --help` is always a read-only query.
if (($#)) && [[ $1 == -h || $1 == --help ]]; then
  case "$cmd" in
    sync|new|pins|doctor|build-image|build-binary|compose|exec|install-shim|generate|g|migrate|harness|verify-pin|verify-pins|pins-path|verify-scaffold|gen-require-all|gen-route-helpers|gen-model-columns|help|version)
      help_for "$cmd" "" || exit 2
      exit 0
      ;;
  esac
fi

case "$cmd" in
  sync)              cmd_sync "$@" ;;
  new)               cmd_new "$@" ;;
  pins)              cmd_pins "$@" ;;
  pins-path)         cmd_pins_path "$@" ;;
  verify-pin)        cmd_verify_pin "$@" ;;
  verify-pins)       cmd_verify_pins "$@" ;;
  verify-scaffold)   cmd_verify_scaffold "$@" ;;
  build-image)       cmd_build_image "$@" ;;
  build-binary)      cmd_build_binary "$@" ;;
  compose)           cmd_compose "$@" ;;
  gen-require-all)   cmd_gen_require_all "$@" ;;
  gen-route-helpers) cmd_gen_route_helpers "$@" ;;
  gen-model-columns) cmd_gen_model_columns "$@" ;;
  generate|g)        cmd_generate "$@" ;;
  migrate)           cmd_migrate "$@" ;;
  exec)              cmd_exec "$@" ;;
  install-shim)      cmd_install_shim "$@" ;;
  harness)           cmd_harness "$@" ;;
  doctor)            cmd_doctor "$@" ;;
  version|--version) cmd_version ;;
  help)              cmd_help "$@" ;;
  ""|-h|--help)      usage_overview ;;
  *)                 cmd_unknown "$cmd" ;;
esac
