  echo "Usage: snails gen-route-helpers [<app_root>] [--check]"
  echo "Internal generator used by the build pipeline."
}

help_gen_model_columns() {
  echo "Usage: snails gen-model-columns [<app_root>] [--check]"
  echo "Internal generator used by the build pipeline."
}

# help_for <topic> [<subcommand>] — print one command's help. Returns 1 for
# an unknown topic so the caller can emit the unknown-command line.
help_for() {
  local topic="${1:-}" sub="${2:-}"
  case "$topic" in
    new) help_new ;;
    generate|g) if [[ $sub == job_queue ]]; then help_generate_job_queue; else help_generate; fi ;;
    migrate) if [[ -n $sub ]]; then help_migrate_sub "$sub" || return 1; else help_migrate; fi ;;
    sync) help_sync ;;
    pins) if [[ $sub == check ]]; then help_pins_check; elif [[ $sub == path ]]; then help_pins_path; else help_pins; fi ;;
    doctor) help_doctor ;;
    build-image) help_build_image ;;
    build-binary) help_build_binary ;;
    compose) help_compose ;;
    exec) help_exec ;;
    install-shim) help_install_shim ;;
    help) help_help ;;
    version) help_version ;;
    harness) if [[ -n $sub ]]; then help_harness_runner "$sub" || return 1; else help_harness; fi ;;
    verify-pin) help_verify_pin ;;
    verify-pins) help_verify_pins ;;
    pins-path) help_pins_path ;;
    verify-scaffold) help_verify_scaffold ;;
    gen-require-all) help_gen_require_all ;;
    gen-route-helpers) help_gen_route_helpers ;;
    gen-model-columns) help_gen_model_columns ;;
    *) return 1 ;;
  esac
}

cmd_help() {
  local topic="${1:-}"
  case "$topic" in
    "") usage_overview ;;
    --all|-a) usage_all ;;
    test|dev)
      echo "[snails] $topic is a project command — run bin/$topic from the app root" >&2
      exit 2
      ;;
    *)
      if ! help_for "$topic" "${2:-}"; then
        echo "[snails] unknown command: $topic" >&2
        echo "[snails] run 'snails help' to see commands" >&2
        exit 2
      fi
      ;;
  esac
}

# dist_own_version — the release version stamped into this dist, or empty
# when the tree is a checkout or an unversioned dist.
dist_own_version() {
  local file="$SNAILS_ROOT/runtime/snails/version.rb" version=""
  [[ -f $file ]] || return 0
  version="$(sed -n 's/^  VERSION = "\(.*\)"/\1/p' "$file" | head -n1)"
  [[ $version == unknown ]] && version=""
  printf '%s' "$version"
}

# dist_own_rev — the full rev this dist was packaged from, or empty in a
# checkout. The stamped metadata is authoritative; the REV file covers a
# dist whose metadata was not stamped.
dist_own_rev() {
  local file="$SNAILS_ROOT/runtime/snails/version.rb" rev=""
  if [[ -f $file ]]; then
    rev="$(sed -n 's/^  REV = "\(.*\)"/\1/p' "$file" | head -n1)"
  fi
  if [[ -z $rev || $rev == unknown ]]; then
    rev=""
    [[ -f $SNAILS_ROOT/REV ]] && rev="$(<"$SNAILS_ROOT/REV")"
  fi
  printf '%s' "$rev"
}

# Version metadata comes from the packaged runtime when present; a checkout
# has no stamped values, so it names its HEAD instead.
cli_version_text() {
  local version rev
  version="$(dist_own_version)"
  rev="$(dist_own_rev)"
  if [[ -z $version || $version == unknown ]]; then
    if ((DIST_MODE)); then
      version="dist"
    elif git -C "$SNAILS_ROOT" rev-parse --short HEAD >/dev/null 2>&1; then
      version="checkout"
      rev="$(git -C "$SNAILS_ROOT" rev-parse --short HEAD)"
    else
      version="unknown"
    fi
  fi
  if [[ -n $rev && $rev != unknown ]]; then
    printf '%s (rev %s)' "$version" "${rev:0:7}"
  else
    printf '%s' "$version"
  fi
}

cmd_version() {
  printf 'snails %s\n' "$(cli_version_text)"
}

# pins — the public pair for the pin declaration and its location. The
# rev-level verify-pin stays internal: the public check is the declaration.
cmd_pins() {
  local action="${1:-}"
  case "$action" in
    check)
      shift
      if [[ ${1:-} == -h || ${1:-} == --help ]]; then help_pins_check; exit 0; fi
      cmd_verify_pins "$@"
      ;;
    path)
      shift
      if [[ ${1:-} == -h || ${1:-} == --help ]]; then help_pins_path; exit 0; fi
      cmd_pins_path "$@"
      ;;
    ""|-h|--help) help_pins; exit 0 ;;
    *)
      echo "[snails] unknown pins command: $action — run 'snails help pins'" >&2
      exit 2
      ;;
  esac
}

# doctor — read-only checks that answer "why is this app not building?"
cmd_doctor() {
  local app_root="" verbose=0 out="" adapter="" pins="" ok=0 warn=0 failed=0
  local app_name="" snals_source="" env="" db_target="" db_dir=""
  while (($#)); do
    case "$1" in
      --verbose) verbose=1; shift ;;
      -h|--help) help_doctor; exit 0 ;;
      -*) echo "[snails] unknown flag: $1" >&2; exit 2 ;;
      *)
        if [[ -n $app_root ]]; then
          echo "[snails] usage: snails doctor [<app_root>] [--verbose]" >&2
          exit 2
        fi
        app_root="$1"; shift
        ;;
    esac
  done
  if [[ -z $app_root ]]; then
    app_root="$(resolve_app_root '[snails]' '<app_root>')" || exit 2
  else
    app_root="$(app_root_for "$app_root")"
  fi
  [[ -d $app_root ]] || { echo "[snails] no such app_root: $app_root" >&2; exit 1; }

  printf '[snails] doctor: %s\n' "$app_root"
  printf '  ok    CLI %s\n' "$(cli_version_text)"
  ok=$((ok + 1))

  pins="$(pins_discover "$app_root")"
  if [[ -n $pins ]]; then
    printf '  ok    pins.toml (%s)\n' "$pins"
    ok=$((ok + 1))
  else
    printf '  fail  pins.toml not found at or above %s\n' "$app_root"
    failed=$((failed + 1))
  fi

  if [[ -n $pins ]]; then
    if out="$(cmd_verify_pins "$app_root" 2>&1)"; then
      printf '  ok    pin declaration\n'
      ok=$((ok + 1))
    else
      printf '  fail  pin declaration\n'
      failed=$((failed + 1))
      printf '        %s\n' "$(printf '%s\n' "$out" | head -n1)"
      if ((verbose)); then printf '%s\n' "$out" | sed 's/^/        /'; fi
    fi
    app_name="$(pins_get "$pins" APP_NAME)" || app_name=""
    if [[ -n $app_name ]]; then
      printf '  ok    APP_NAME: %s\n' "$app_name"
      ok=$((ok + 1))
    else
      printf '  warn  APP_NAME is not declared in %s — dev database and container names need it\n' "$pins"
      warn=$((warn + 1))
    fi

    snals_source="$(pins_get "$pins" SNALS_SOURCE)" || snals_source=""
    snals_source="${snals_source:-pin}"
    case "$snals_source" in
      pin)
        printf '  ok    SNALS_SOURCE: pin\n'
        ok=$((ok + 1))
        ;;
      checkout)
        printf '  warn  SNALS_SOURCE: checkout (builds the core working tree as it stands)\n'
        warn=$((warn + 1))
        ;;
      *)
        printf '  fail  SNALS_SOURCE: %s (want pin|checkout)\n' "$snals_source"
        failed=$((failed + 1))
        ;;
    esac
  fi

  env="${SNAILS_ENV:-development}"
  case "$env" in
    development|test|staging|production)
      printf '  ok    SNAILS_ENV: %s\n' "$env"
      ok=$((ok + 1))
      ;;
    *)
      printf '  fail  SNAILS_ENV: %s (want development|test|staging|production)\n' "$env"
      failed=$((failed + 1))
      ;;
  esac
  if [[ $env == production ]]; then
    if [[ -n ${SECRET_KEY_BASE:-} ]]; then
      printf '  ok    SECRET_KEY_BASE is set\n'
      ok=$((ok + 1))
    else
      printf '  fail  SECRET_KEY_BASE is not set (required in production)\n'
      failed=$((failed + 1))
    fi
  else
    printf '  skip  SECRET_KEY_BASE (only required in production)\n'
  fi

  if out="$(cmd_sync --check "$app_root" 2>&1)"; then
    printf '  ok    snails-core and toolchain\n'
    ok=$((ok + 1))
  else
    printf '  fail  snails-core or toolchain needs attention\n'
    failed=$((failed + 1))
    # `sync --check` may start with the core-developer checkout notice and
    # successful progress lines; the actionable line is the stale/failure
    # report.
    local reason
    reason="$(printf '%s\n' "$out" | grep -E 'stale|missing|not found|failed|violates|no app root|not published' | head -n1)"
    [[ -n $reason ]] || reason="$(printf '%s\n' "$out" | grep -v '^notice:' | head -n1)"
    printf '        %s\n' "$reason"
    if ((verbose)); then printf '%s\n' "$out" | sed 's/^/        /'; fi
  fi

  if out="$(database_adapter_for "$app_root" 2>&1)"; then
    adapter="$out"
    printf '  ok    database adapter: %s\n' "$adapter"
    ok=$((ok + 1))
  else
    printf '  fail  database adapter\n'
    failed=$((failed + 1))
    printf '        %s\n' "$(printf '%s\n' "$out" | head -n1)"
    if ((verbose)); then printf '%s\n' "$out" | sed 's/^/        /'; fi
  fi

  if [[ $adapter == pg ]]; then
    if [[ -n ${PG_URL:-} ]]; then
      printf '  ok    database target: PG_URL is set\n'
      ok=$((ok + 1))
    else
      printf '  warn  database target: PG_URL is not set — bin/dev uses a Docker container\n'
      warn=$((warn + 1))
    fi
    if command -v psql >/dev/null 2>&1; then
      printf '  ok    psql\n'
      ok=$((ok + 1))
    else
      printf '  fail  psql not found — install postgresql-client\n'
      failed=$((failed + 1))
    fi
    if [[ -n ${PG_URL:-} ]]; then
      printf '  skip  docker (PG_URL is set)\n'
    elif command -v docker >/dev/null 2>&1; then
      printf '  ok    docker\n'
      ok=$((ok + 1))
    else
      printf '  warn  docker not found — set PG_URL or install Docker for the pg dev container\n'
      warn=$((warn + 1))
    fi
  elif [[ $adapter == sqlite ]]; then
    db_target="${DATABASE_PATH:-$app_root/storage/development.sqlite3}"
    printf '  ok    database target: %s\n' "$db_target"
    ok=$((ok + 1))
    db_dir="$(dirname "$db_target")"
    if [[ -d $db_dir && -w $db_dir ]]; then
      printf '  ok    database directory is writable\n'
      ok=$((ok + 1))
    else
      printf '  warn  database directory is missing or not writable: %s (bin/dev or snails migrate apply creates it)\n' "$db_dir"
      warn=$((warn + 1))
    fi
    if [[ -f $db_target ]]; then
      if [[ -r $db_target ]]; then
        printf '  ok    database file is readable\n'
        ok=$((ok + 1))
      else
        printf '  fail  database file is not readable: %s\n' "$db_target"
        failed=$((failed + 1))
      fi
    else
      printf '  skip  database file not created yet (bin/dev or snails migrate apply creates it)\n'
    fi
    if command -v sqlite3 >/dev/null 2>&1; then
      printf '  ok    sqlite3\n'
      ok=$((ok + 1))
    else
      printf '  fail  sqlite3 not found — install sqlite3\n'
      failed=$((failed + 1))
    fi
    if [[ -f $app_root/compose.yml ]]; then
      if command -v docker >/dev/null 2>&1; then
        printf '  ok    compose.yml (docker available)\n'
        ok=$((ok + 1))
      else
        printf '  warn  compose.yml is present but docker is not installed (deploy only)\n'
        warn=$((warn + 1))
      fi
    fi
  fi

  printf '[snails] %d ok, %d warning, %d failed\n' "$ok" "$warn" "$failed"
  ((failed == 0)) || exit 1
}

# Read SNALS_REV (the core pin) from a pins file.
pins_rev() {
  pins_get "$1" SNALS_REV
}

# pins_rev_is_full <rev> — the edge form of an SNALS_REV declaration: a
# full 40-hex commit id. A dist release tag and asset name derive from the
# full form; a git checkout also accepts an abbreviation, which would let
# one pins file mean two things. The release form is a vX.Y.Z version
# (pins_rev_is_version); both are checked where the pin is read (sync,
# verify-pins) so the refusal lands before any mode logic.
pins_rev_is_full() {
  [[ $1 =~ ^[0-9a-f]{40}$ ]]
}

# pins_rev_is_version <rev> — the release-channel declaration: a vX.Y.Z
# tag name (optional -prerelease), naming a published core release. It
# and the 40-hex form are disjoint (v is not hex), so one pins file can
# never mean two things: a version is the release channel, a full rev is
# the edge channel for content no release names yet.
pins_rev_is_version() {
  [[ $1 =~ ^v[0-9]+\.[0-9]+\.[0-9]+(-[0-9A-Za-z.-]+)?$ ]]
}

# resolve_pin_rev <rev> [pins_label] — the declared pin turned into the
# full 40-hex commit id every downstream step keys on: a full rev passes
# through untouched; a vX.Y.Z pin resolves through its release tag — git
# in a checkout, the tag annotation in `snails-rb/dist` for an
# installed dist (SNAILS_GIT_BASE_URL overrides the API base for tests,
# like SNAILS_DIST_BASE_URL). Prints the full rev on stdout; an
# unresolvable version fails loud naming the tag and the repair.
resolve_pin_rev() {
  local rev="$1" label="${2:-}" resolved
  if pins_rev_is_full "$rev"; then
    printf '%s' "$rev"
    return 0
  fi
  if ! pins_rev_is_version "$rev"; then
    echo "[snails] SNALS_REV($rev)${label:+ in $label} is not a full 40-hex rev or a vX.Y.Z version — record the full value (run 'git rev-parse $rev' in the snails checkout)" >&2
    return 1
  fi
  if ((DIST_MODE)); then
    if ! resolved="$(dist_version_rev "$rev")"; then
      echo "[snails] SNALS_REV($rev)${label:+ in $label} names no release tag $rev — publish the release, or check the version" >&2
      return 1
    fi
  else
    if ! resolved="$(git -C "$SNAILS_ROOT" rev-parse --verify "refs/tags/$rev^{commit}" 2>/dev/null)"; then
      echo "[snails] SNALS_REV($rev)${label:+ in $label} names no tag in this snails checkout — run 'git fetch --tags', or check the version" >&2
      return 1
    fi
  fi
  if [[ -z $resolved ]]; then
    echo "[snails] SNALS_REV($rev)${label:+ in $label} resolved to no commit — check the release tag" >&2
    return 1
  fi
  printf '%s' "$resolved"
}

# Read the retired DB adapter declaration (DB=sqlite|pg). The adapter now lives
# in the app's config/database.rb (app-owned database configuration); this value seeds
# that file when sync finds a tree without it, and is passed to the engine
# so a pin rev from before the app-owned database configuration still materializes its
# runtime/db.rb database configuration correctly. Unset means sqlite (the core default).
pins_db() {
  pins_get "$1" DB
}

# pins_declared_spinel <file> — the spinel rev a pins file declares:
# SPINEL_REV (the pair record) or, for revs from before the record, the
# last token of the retired SPINEL_VALIDATED_REVS list (the value `new`
# stamped back then, so existing pairs keep verifying). Prints nothing
# when the file declares neither; a malformed line is not the wanted
# declaration here (the app's own pins file is still read strictly).
pins_declared_spinel() {
  local file="$1" value list
  value="$(pins_get "$file" SPINEL_REV)" || value=""
  if [[ -z $value ]]; then
    list="$(pins_get "$file" SPINEL_VALIDATED_REVS)" || list=""
    value="${list##* }"
  fi
  printf '%s' "$value"
}

# dist_repo — the repo whose releases carry the dist assets. The source
# repository publishes here; installs read only this release channel.
dist_repo() {
  printf '%s' "snails-rb/dist"
}

# dist_base — the download base for the direct URL layout
# (`rev-<rev>/snails-dist-<rev>.tar.gz` + `.sha256`). Overridable so a
# mirror — or a test — can serve the same layout.
dist_base() {
  printf '%s' "${SNAILS_DIST_BASE_URL:-https://github.com/$(dist_repo)/releases/download}"
}

# dist_download <tag> <asset> <out> — fetch one release asset from the
# public release repo. SNAILS_DIST_BASE_URL overrides the base so a
# mirror — or a test — can serve the same layout.
dist_download() {
  local tag="$1" asset="$2" out="$3"
  curl -fsSL -o "$out" "$(dist_base)/$tag/$asset"
}

# dist_git_base — the repo's git-data API base (tag objects).
# SNAILS_GIT_BASE_URL overrides it for a mirror or a test.
dist_git_base() {
  printf '%s' "${SNAILS_GIT_BASE_URL:-https://api.github.com/repos/$(dist_repo)}"
}

# dist_version_cache_file <version> — the local map from a version tag to
# the rev it names. Version tags are immutable, so a recorded mapping never
# goes stale and repeat pin checks stay off the API.
dist_version_cache_file() {
  printf '%s' "${XDG_CACHE_HOME:-$HOME/.cache}/snails/dist/versions/$1"
}

# dist_version_rev_store <version> <rev> — record a resolved mapping. The
# map is an optimization: an unwritable cache must not fail a pin that
# already resolved.
dist_version_rev_store() {
  local version="$1" rev="$2" cache
  cache="$(dist_version_cache_file "$version")"
  mkdir -p "$(dirname "$cache")" 2>/dev/null || return 0
  printf '%s\n' "$rev" > "$cache" 2>/dev/null || true
}

# dist_version_rev <version> — the source rev a version tag names in
# `snails-rb/dist`. This dist's own version resolves locally; any other
# version reads the local map, then the annotated tag (the message carries
# `REV=<source rev>`, publish-dist writes it). Prints the full rev; fails
# when the tag or the marker is missing.
dist_version_rev() {
  local version="$1" cache rev own_version
  local ref_json object_sha object_type tag_json
  cache="$(dist_version_cache_file "$version")"
  if [[ -f $cache ]]; then
    rev="$(<"$cache")" || rev=""
    if [[ $rev =~ ^[0-9a-f]{40}$ ]]; then
      printf '%s' "$rev"
      return 0
    fi
  fi
  own_version="$(dist_own_version)"
  if [[ -n $own_version && $version == "$own_version" ]]; then
    rev="$(dist_own_rev)"
    if [[ $rev =~ ^[0-9a-f]{40}$ ]]; then
      dist_version_rev_store "$version" "$rev"
      printf '%s' "$rev"
      return 0
    fi
  fi
  ref_json="$(curl -fsSL "$(dist_git_base)/git/ref/tags/$version")" || return 1
  object_sha="$(printf '%s' "$ref_json" | tr -d '[:space:]' \
    | grep -o '"sha":"[0-9a-f]\{40\}"' | head -n1 | grep -o '[0-9a-f]\{40\}')"
  object_type="$(printf '%s' "$ref_json" | tr -d '[:space:]' \
    | grep -o '"type":"[a-z]*"' | head -n1 | sed 's/.*"type":"\([a-z]*\)".*/\1/')"
  [[ -n $object_sha && $object_type == "tag" ]] || return 1
  tag_json="$(curl -fsSL "$(dist_git_base)/git/tags/$object_sha")" || return 1
  rev="$(printf '%s' "$tag_json" | grep -o 'REV=[0-9a-f]\{40\}' | head -n1 | cut -d= -f2)"
  [[ -n $rev ]] || return 1
  dist_version_rev_store "$version" "$rev"
  printf '%s' "$rev"
}

# dist_cache_dir <rev> — the per-rev dist cache (evictable state, like the
# spinel toolchain cache next to it).
dist_cache_dir() {
  printf '%s' "${XDG_CACHE_HOME:-$HOME/.cache}/snails/dist/$1"
}

# sha256_check <dir> <file> — verify a sha256sum-format sidecar in <dir>.
sha256_check() {
  local dir="$1" file="$2"
  if command -v sha256sum >/dev/null 2>&1; then
    (cd "$dir" && sha256sum -c "$file")
  else
    (cd "$dir" && shasum -a 256 -c "$file")
  fi
}

# fetch_dist <rev> — download, verify, and cache the published dist for a
# rev. The rev must be the full 40-hex form: the release tag and asset
# name derive from it, so an abbreviated pin cannot be resolved without
# a checkout. Atomic — a failed download or a checksum mismatch never
# leaves a cache entry behind. Progress goes to stderr; the resolved
# cache path goes to stdout only from resolve_dist, because callers
# capture it.
fetch_dist() {
  local rev="$1" dest tmp
  if [[ ! $rev =~ ^[0-9a-f]{40}$ ]]; then
    echo "[snails] SNALS_REV=$rev is not a full 40-hex rev — dist mode cannot resolve an abbreviated pin (bump it or use a checkout)" >&2
    return 1
  fi
  dest="$(dist_cache_dir "$rev")"
  tmp="${dest}.tmp.$$"
  rm -rf "$tmp"
  mkdir -p "$tmp"
  echo "[snails] fetching dist $rev" >&2
  if ! dist_download "rev-$rev" "snails-dist-$rev.tar.gz" "$tmp/snails-dist-$rev.tar.gz"; then
    rm -rf "$tmp"
    echo "[snails] dist download failed for $rev" >&2
    return 1
  fi
  if ! dist_download "rev-$rev" "snails-dist-$rev.tar.gz.sha256" "$tmp/snails-dist-$rev.tar.gz.sha256"; then
    rm -rf "$tmp"
    echo "[snails] dist checksum download failed for $rev" >&2
    return 1
  fi
  if ! sha256_check "$tmp" "snails-dist-$rev.tar.gz.sha256" >/dev/null; then
    rm -rf "$tmp"
    echo "[snails] dist checksum mismatch for $rev — refusing the download" >&2
    return 1
  fi
  tar -xzf "$tmp/snails-dist-$rev.tar.gz" -C "$tmp"
  rm -f "$tmp/snails-dist-$rev.tar.gz" "$tmp/snails-dist-$rev.tar.gz.sha256"
  if [[ ! -f $tmp/REV || $(<"$tmp/REV") != "$rev" ]]; then
    rm -rf "$tmp"
    echo "[snails] the downloaded dist does not carry REV=$rev" >&2
    return 1
  fi
  rm -rf "$dest"
  mv "$tmp" "$dest"
  # fetch_dist runs inside cmd_sync (bash's dynamic scope), where the
  # caller's --verbose decides the detail: the cache path is internal,
  # so the default report only says the rev is cached.
  if (( ${verbose:-0} )); then
    echo "[snails] dist $rev -> $dest (cache)" >&2
  else
    echo "[snails] dist $rev cached" >&2
  fi
}

# resolve_dist <rev> — the engine tree for a pin in dist mode: this dist
# itself when the pin is its own rev, the cache when present, otherwise
# a fresh verified download. Only the path goes to stdout.
resolve_dist() {
  local rev="$1" own="" dest
  [[ -f $SNAILS_ROOT/REV ]] && own="$(<"$SNAILS_ROOT/REV")"
  if [[ -n $own && $rev == "$own" ]]; then
    printf '%s' "$SNAILS_ROOT"
    return 0
  fi
  dest="$(dist_cache_dir "$rev")"
  if [[ -f $dest/REV && $(<"$dest/REV") == "$rev" ]]; then
    printf '%s' "$dest"
    return 0
  fi
  fetch_dist "$rev" || return 1
  printf '%s' "$dest"
}

# verify_pin_dist <rev> — dist-mode pin check: the rev resolves through a
# published release (this dist's own rev trivially does). The checksum
# sidecar's presence is the publication proof; nothing is downloaded.
verify_pin_dist() {
  local rev="$1" own=""
  [[ -f $SNAILS_ROOT/REV ]] && own="$(<"$SNAILS_ROOT/REV")"
  if [[ -n $own && $rev == "$own" ]]; then
    echo "[snails] SNALS_REV($rev) is this dist's own rev — usable"
    return 0
  fi
  if [[ ! $rev =~ ^[0-9a-f]{40}$ ]]; then
    echo "[snails] SNALS_REV=$rev is not a full 40-hex rev — dist mode cannot resolve an abbreviated pin" >&2
    return 1
  fi
  if dist_download "rev-$rev" "snails-dist-$rev.tar.gz.sha256" /dev/null; then
    echo "[snails] SNALS_REV($rev) is published — usable (release rev-$rev)"
  else
    # An unpublished full rev is an edge pin: it names content no release
    # carries yet. Say which channel the reader is on — the refusal is
    # the channel split, not a broken pin.
    echo "[snails] SNALS_REV($rev) is not published — no reachable release rev-$rev" >&2
    echo "[snails] this is an edge pin: use a snails checkout (SNAILS_DIR) for it, or pin a released vX.Y.Z version" >&2
    return 1
  fi
}

# declared_spinel_checkout <rev> — the spinel rev declared by the pins
# file at <rev> in this checkout (git show: a pin's content is what its
# commit carried, never what the working tree holds). Prints the value
# and returns 0, or returns 1 when the rev declares none.
declared_spinel_checkout() {
  local rev="$1" value content_tmp
  content_tmp="$(mktemp)"
  TMPDIRS+=("$content_tmp")
  git -C "$SNAILS_ROOT" cat-file -e "$rev:pins.toml" 2>/dev/null || return 1
  git -C "$SNAILS_ROOT" show "$rev:pins.toml" > "$content_tmp" 2>/dev/null || return 1
  value="$(pins_declared_spinel "$content_tmp")"
  [[ -n $value ]] || return 1
  printf '%s' "$value"
}

# declared_spinel_dist <rev> — the spinel rev declared at <rev> in dist
# mode: this dist's own pin when <rev> is its own REV, the per-rev dist
# cache next (a previous sync fetched that tree), the release's pins.toml
# asset last. Return 0 with the value printed; 1 = reached but declares
# none; 2 = not reachable (reported by the caller).
declared_spinel_dist() {
  local rev="$1" own="" dir value tmp
  [[ -f $SNAILS_ROOT/REV ]] && own="$(<"$SNAILS_ROOT/REV")"
  if [[ -n $own && $rev == "$own" ]]; then
    value="$(pins_declared_spinel "$SNAILS_ROOT/pins.toml")"
    [[ -n $value ]] || return 1
    printf '%s' "$value"
    return 0
  fi
  dir="$(dist_cache_dir "$rev")"
  if [[ -f $dir/pins.toml ]]; then
    value="$(pins_declared_spinel "$dir/pins.toml")"
    if [[ -n $value ]]; then
      printf '%s' "$value"
      return 0
    fi
  fi
  tmp="$(mktemp)"
  TMPDIRS+=("$tmp")
  dist_download "rev-$rev" "pins.toml" "$tmp" 2>/dev/null || return 2
  value="$(pins_declared_spinel "$tmp")"
  [[ -n $value ]] || return 1
  printf '%s' "$value"
  return 0
}

# resolve_engine_dir <tree> — print the engine directory of a core tree
# (a pin rev extraction, a dist cache entry, an installed dist, or this
# checkout). The directory was renamed twice: script -> scripts -> cli. A
# tree carries exactly one generation, so the newest name wins when more
# than one is somehow present.
resolve_engine_dir() {
  local tree="$1"
  if [[ -d $tree/cli ]]; then
    printf '%s' "$tree/cli"
  elif [[ -d $tree/scripts ]]; then
    printf '%s' "$tree/scripts"
  else
    printf '%s' "$tree/script"
  fi
}

# report_core_drift <pin_tree> <app_tree> — the verbose half of
# `sync --check`: a category summary plus one entry per difference. Paths
# print app-relative (`snails-core/<rel>`) and the staging tree reads as the
# pin it is — its mktemp path is internal detail, not the reader's. The
# default check path deliberately prints the action line alone, so the
# drift list lives only here. diff messages are parsed, so the
# categories come from the C locale's spellings.
report_core_drift() {
  local pin_tree="$1" app_tree="$2" line rest rel entries=()
  local changed=0 pin_only=0 tree_only=0
  while IFS= read -r line; do
    case "$line" in
      # "Only in <dir>: <name>" — <dir> is the vendored core root or a
      # subdirectory of it, so the halves re-join into one relative path.
      "Only in $pin_tree"*)
        rest="${line#"Only in $pin_tree"}"; rel="${rest%%: *}"
        rel="${rel#/}"; rel="${rel:+$rel/}${line##*: }"
        pin_only=$((pin_only + 1))
        entries+=("pin-only  $SNAILS_VENDOR_DIR/$rel")
        ;;
      "Only in $app_tree"*)
        rest="${line#"Only in $app_tree"}"; rel="${rest%%: *}"
        rel="${rel#/}"; rel="${rel:+$rel/}${line##*: }"
        tree_only=$((tree_only + 1))
        entries+=("tree-only $SNAILS_VENDOR_DIR/$rel")
        ;;
      # "Files A and B differ" — both sides carry the same relative path.
      "Files $pin_tree/"*" and "*" differ")
        rest="${line#"Files $pin_tree/"}"; rel="${rest%% and *}"
        changed=$((changed + 1))
        entries+=("changed   $SNAILS_VENDOR_DIR/$rel")
        ;;
    esac
  done < <(LC_ALL=C diff -rq "$pin_tree" "$app_tree" 2>/dev/null || true)
  printf '[snails]   changed %d · pin-only %d · tree-only %d\n' "$changed" "$pin_only" "$tree_only"
  local entry
  for entry in ${entries[@]+"${entries[@]}"}; do
    printf '[snails]   %s\n' "$entry"
  done
}

cmd_sync() {
  local app_root="" pins="" check=0 verbose=0 db="" from_checkout=0 explicit=0
  local skip_toolchain=0
  while (($#)); do
    case "$1" in
      --pins)    pins="${2:-}"; explicit=1; shift 2 ;;
      --from-checkout) from_checkout=1; shift ;;
      --check)   check=1; shift ;;
      --skip-toolchain) skip_toolchain=1; shift ;;
      --verbose) verbose=1; shift ;;
      -h|--help) help_for sync; exit 0 ;;
      -*) echo "[snails] unknown flag: $1" >&2; exit 2 ;;
      *)  app_root="$1"; shift ;;
    esac
  done
  if [[ -z $app_root ]]; then
    app_root="$(resolve_app_root '[snails]' '<app_root>' "$pins")" || exit 2
  else
    # An explicit argument may be the repository root of a src/ layout —
    # the same rule the build engines use. The omitted case resolves the
    # same root through resolve_app_root.
    app_root="$(app_root_for "$app_root")"
  fi
  [[ -d $app_root ]] || { echo "[snails] no such app_root: $app_root" >&2; exit 1; }

  # The core checkout is the vendor SOURCE, not an app tree: syncing it
  # onto itself would delete its runtime/ (self-vendor), and a dist CLI
  # pointed at a checkout would overwrite it with the CLI tree's copy.
  # Refuse by identity, and by the scaffold/ marker — a consumer app
  # never carries scaffold/.
  if [[ "$(cd "$app_root" && pwd -P)" == "$(cd "$SNAILS_ROOT" && pwd -P)" ]]; then
    echo "[snails] $app_root is the core checkout itself — sync targets an app tree" >&2
    exit 1
  fi
  if [[ -f "$app_root/scaffold/main.rb" ]]; then
    echo "[snails] $app_root looks like a core checkout (scaffold/ present) — sync targets an app tree" >&2
    exit 1
  fi

  # Pin resolution: explicit --pins wins, otherwise the nearest pins file
  # at or above <app_root> declares the project pin. The pins file's
  # SNALS_SOURCE selects the vendoring source: "pin" restores SNALS_REV,
  # "checkout" takes the core checkout's working tree. A tree without a
  # pin rev is declaration-only and keeps the pre-declaration behavior —
  # vendoring from this checkout. --from-checkout confirms the checkout
  # source; it never overrides the declaration.
  if [[ -z $pins ]]; then
    local discovered
    discovered="$(pins_discover "$app_root")"
    [[ -n $discovered ]] && pins="$discovered"
  fi

  local source="pin"
  if [[ -n $pins ]]; then
    [[ -f $pins ]] || { echo "[snails] no such pins file: $pins" >&2; exit 1; }
    source="$(pins_source "$pins")" || exit 1
    [[ -n "$(pins_rev "$pins")" ]] || source="checkout"
  fi
  if [[ $source == "checkout" ]]; then
    if ((DIST_MODE)); then
      echo "[snails] $pins declares SNALS_SOURCE=\"checkout\" — run from the core checkout, or set SNALS_SOURCE=\"pin\"" >&2
      exit 1
    fi
    from_checkout=1
  elif ((from_checkout)) && [[ -n $pins ]]; then
    echo "[snails] $pins declares SNALS_SOURCE=\"pin\" — set it to \"checkout\" to vendor from this checkout" >&2
    exit 1
  fi

  # With a pin rev the pin is the content source: a checkout restores the
  # core paths of that rev with git, an installed dist downloads the
  # published dist release — either way the engine and the vendored bytes
  # are the pin's, not this tree's. A declared pin (full rev or vX.Y.Z
  # version) is resolved to its full rev here, once; every step below
  # keys on the full form.
  local engine="$SNAILS_ROOT" rev="" pin_declared=""
  if [[ -n $pins ]]; then
    [[ -f $pins ]] || { echo "[snails] no such pins file: $pins" >&2; exit 1; }
    pin_declared="$(pins_rev "$pins")"
    rev="$pin_declared"
    if [[ -z $rev ]]; then
      if ((explicit)); then
        echo "[snails] SNALS_REV unset in $pins" >&2
        exit 1
      fi
      echo "[snails] $pins has no SNALS_REV — declaration only; vendoring from this checkout"
    else
      rev="$(resolve_pin_rev "$rev" "$pins")" || exit 1
    fi
    # DB is the retired adapter declaration: the engine seeds a missing
    # config/database.rb database configuration from it (sqlite default), and an engine
    # from a rev that predates the app-owned database configuration materializes its
    # runtime/db.rb from it — so such a pin still syncs its adapter
    # correctly. The current engine ignores it once the database configuration exists.
    db="$(pins_db "$pins")"
  fi
  if [[ -n $rev && $from_checkout -eq 0 ]]; then
    if ((DIST_MODE)); then
      # No git here: the pin resolves through the dist's own rev, the
      # per-rev cache, then a verified download (all loud on failure).
      engine="$(resolve_dist "$rev")" || exit 1
    else
      bash "$SNAILS_ROOT/cli/verify-pin.sh" "$rev" >&2
      engine="$(mktemp -d)"
      TMPDIRS+=("$engine")
      # The engine directory's generations are cli/ (current), scripts/
      # (one rename ago), and script/ (the oldest). The archive path must
      # match the rev (a missing pathspec is fatal), so the rev decides.
      # The pins file is pins.toml — verify-pin above already refused a
      # rev that carries no pins.toml.
      local rev_engine_dir="cli"
      if ! git -C "$SNAILS_ROOT" cat-file -e "$rev:cli" 2>/dev/null; then
        if git -C "$SNAILS_ROOT" cat-file -e "$rev:scripts" 2>/dev/null; then
          rev_engine_dir="scripts"
        else
          rev_engine_dir="script"
        fi
      fi
      git -C "$SNAILS_ROOT" archive "$rev" -- runtime "$rev_engine_dir" scaffold bin pins.toml | tar -x -C "$engine"
    fi
  fi

  # The version metadata that goes into the vendored runtime. A released pin
  # names its version; a checkout uses HEAD and marks a dirty tree. The sync
  # engine writes these values into runtime/snails/version.rb, so the binary
  # never reads the pins file at runtime.
  local core_version="" core_rev=""
  if [[ -n $rev && $from_checkout -eq 0 ]]; then
    core_rev="$rev"
    if pins_rev_is_version "$pin_declared"; then
      core_version="$pin_declared"
    else
      core_version="$rev"
    fi
  elif [[ -e "$SNAILS_ROOT/.git" ]]; then
    core_rev="$(git -C "$SNAILS_ROOT" rev-parse HEAD 2>/dev/null || true)"
    core_version="$core_rev"
    if [[ -n $core_rev && -n "$(git -C "$SNAILS_ROOT" status --porcelain -- runtime cli scaffold bin pins.toml 2>/dev/null)" ]]; then
      core_version="$core_version-dirty"
    fi
  elif [[ -f "$SNAILS_ROOT/REV" ]]; then
    core_rev="$(<"$SNAILS_ROOT/REV")"
    core_version="$core_rev"
  fi

  # A dist artifact carries its own version metadata: sync copies it as-is so
  # a bad publish stays visible. A checkout (or --from-checkout) has only the
  # default constants, so the CLI stamps the resolved values on the way in.
  local stamp_engine=1 stamp_version="" stamp_rev=""
  if ((DIST_MODE)) && [[ -n $rev && $from_checkout -eq 0 ]]; then
    stamp_engine=0
  fi
  if ((stamp_engine)); then
    stamp_version="$core_version"
    stamp_rev="$core_rev"
  fi

  # The pins file's SPINEL_REV binds every compile in this app tree to a
  # specific spinel build: materialize it next to the pins file (a fresh
  # project copy costs two version checks, no writes). The engine's own
  # tree carries the resolver — at cli/ (scripts/ or script/ in a
  # pre-rename engine) since the harness engines moved into the CLI, at
  # scaffold/harness/ in older pins (probed, so an old pinned engine
  # keeps materializing). A pin older than the toolchain contract simply
  # predates the feature and keeps its old behavior.
  if [[ -n $pins && $skip_toolchain -eq 0 ]]; then
    local toolchain="" engine_dir
    engine_dir="$(resolve_engine_dir "$engine")"
    if [[ -f "$engine_dir/toolchain.sh" ]]; then
      toolchain="$engine_dir/toolchain.sh"
    elif [[ -f "$engine/scaffold/harness/toolchain.sh" ]]; then
      toolchain="$engine/scaffold/harness/toolchain.sh"
    fi
    if [[ -n $toolchain ]]; then
      # shellcheck source=toolchain.sh
      source "$toolchain"
      if ((check)); then
        spinel_toolchain_check "$pins" "$app_root"
      else
        spinel_toolchain_ensure "$pins"
      fi
    else
      echo "[snails] $pins pin predates the spinel toolchain contract — toolchain materialization skipped"
    fi
  fi

  if ((check)); then
    # Rebuild into a throwaway tree and diff the vendored core. A staging
    # tree with only snails-core/ skips the contract steps the way
    # consumers' own --check did. The staging run's output is progress, not
    # the report: it is captured and only surfaces when the rebuild itself
    # fails (a failure must never go quiet).
    local tmp staging_log
    tmp="$(mktemp -d)"
    TMPDIRS+=("$tmp")
    staging_log="$tmp/sync-runtime.log"
    if [[ -d $app_root/$SNAILS_VENDOR_DIR ]]; then
      cp -R "$app_root/$SNAILS_VENDOR_DIR" "$tmp/$SNAILS_VENDOR_DIR"
    fi
    if ! SNAILS_VERSION="$stamp_version" SNAILS_REV="$stamp_rev" DB="$db" bash "$(resolve_engine_dir "$engine")/sync-runtime.sh" "$tmp" >/dev/null 2>"$staging_log"; then
      echo "[snails] the staged rebuild behind --check failed:" >&2
      cat "$staging_log" >&2
      exit 1
    fi
    if LC_ALL=C diff -rq "$tmp/$SNAILS_VENDOR_DIR" "$app_root/$SNAILS_VENDOR_DIR" >/dev/null 2>&1; then
      echo "[snails] $app_root $SNAILS_VENDOR_DIR in sync"
    else
      # The message exists to say "sync": the action line is the output,
      # and the drift list (diagnostics) prints only with --verbose.
      local sync_arg sync_command
      sync_arg="$(app_root_argument "$app_root")"
      sync_command="snails sync"
      [[ -n $sync_arg ]] && sync_command+=" $(shell_quote "$sync_arg")"
      echo "[snails] $app_root $SNAILS_VENDOR_DIR is stale — run: $sync_command" >&2
      if ((verbose)); then
        report_core_drift "$tmp/$SNAILS_VENDOR_DIR" "$app_root/$SNAILS_VENDOR_DIR" >&2
      fi
      exit 1
    fi
  else
    local engine_args=("$app_root")
    ((verbose)) && engine_args+=("--verbose")
    local core_source="$engine/runtime" result_verb="synced" core_diff=""
    if [[ -d $core_source && -d $app_root/$SNAILS_VENDOR_DIR ]]; then
      core_diff="$(diff -rq "$core_source" "$app_root/$SNAILS_VENDOR_DIR" 2>/dev/null || true)"
      if [[ -z "$(printf '%s\n' "$core_diff" | grep -v '/snails/version.rb')" ]]; then
        result_verb="already in sync"
      fi
    fi
    SNAILS_VERSION="$stamp_version" SNAILS_REV="$stamp_rev" DB="$db" bash "$(resolve_engine_dir "$engine")/sync-runtime.sh" "${engine_args[@]}"

    # One result line on stdout says what is now vendored; the steps and
    # their detail (internal paths) stay on stderr. `checkout` covers a
    # pin-less run from a working tree; an installed dist names its REV.
    # A version pin reports the declared name (v1.0.0 reads better than
    # its resolved rev); a rev pin keeps the 7-char label.
    local core_label="checkout" spinel=""
    if [[ -n $pin_declared ]]; then
      if pins_rev_is_version "$pin_declared"; then
        core_label="$pin_declared"
      else
        core_label="${pin_declared:0:7}"
      fi
    elif [[ -f $SNAILS_ROOT/REV ]]; then
      core_label="$(<"$SNAILS_ROOT/REV")"
      core_label="${core_label:0:7}"
    fi
    if [[ -n $pins && -f $pins ]]; then
      spinel="$(pins_get "$pins" SPINEL_REV)"
    fi
    if [[ -n $spinel ]]; then
      echo "[snails] $app_root $result_verb (core $core_label, spinel ${spinel:0:7})"
    else
      echo "[snails] $app_root $result_verb (core $core_label)"
    fi
  fi
}

# substitute_placeholder <file> <placeholder> <value> — replace every
# <placeholder> occurrence in <file> with <value>, verbatim. sed-style
# replacement (and bash >= 5.2 pattern substitution) expands `&` in the
# value as the match — an app directory name may contain one — and the
# GNU-vs-BSD `sed -i` forms differ, so the value is spliced in literally.
substitute_placeholder() {
  local file="$1" placeholder="$2" value="$3" source rest result prefix
  source="$(<"$file")"
  rest="$source"
  result=""
  while [[ $rest == *"$placeholder"* ]]; do
    prefix="${rest%%"$placeholder"*}"
    result="$result$prefix$value"
    rest="${rest#*"$placeholder"}"
  done
  printf '%s\n' "$result$rest" > "$file"
}

# Create a project skeleton from the scaffolds and vendor the core.
# The generated tree serves `GET /up`; extend it with app code.
cmd_new() {
  local dir="" database="sqlite" full=0
  while (($#)); do
    case "$1" in
      --database=*) database="${1#--database=}"; shift ;;
      --scaffold) full=1; shift ;;
      -h|--help) help_for new; exit 0 ;;
      -*) echo "[snails] unknown flag: $1" >&2; exit 2 ;;
      *) dir="$1"; shift ;;
    esac
  done
  [[ -n $dir ]] || { echo "[snails] usage: snails new <dir> [--database=sqlite|postgresql] [--scaffold]" >&2; exit 2; }
  local database_adapter database_backend
  case "$database" in
    sqlite)     database_adapter="sqlite"; database_backend="sqlite" ;;
    postgresql) database_adapter="pg";     database_backend="postgresql" ;;
    *) echo "[snails] unknown database: $database (want sqlite|postgresql)" >&2; exit 2 ;;
  esac
  if [[ -e $dir ]]; then
    if [[ ! -d $dir || -n "$(ls -A "$dir" 2>/dev/null)" ]]; then
      echo "[snails] target exists and is not empty: $dir" >&2
      exit 1
    fi
  else
    mkdir -p "$dir"
  fi
  # The sqlite adapter's default database lives under storage/. Creating it
  # with the tree lets the first `snails migrate apply` work before any boot;
  # the folder is gitignored, so a clone still gets it from apply (and the
  # dev runner). pg owns no app-side database directory.
  if [[ $database_backend == sqlite ]]; then
    mkdir -p "$dir/storage"
  fi
  local name db_name
  name="$(basename "$(cd "$dir" && pwd)")"
  # Sanitize the directory name so the pg database name (<app>_production)
  # stays a plain identifier.
  db_name="${name//[^a-zA-Z0-9]/_}_production"

  # Scaffold-owned files: the server entry and the core-default require-all
  # files. The boot chain ships inside the vendored core, and the `/up`
  # health controller lives in the core — every app serves it by
  # declaring the route.
  mkdir -p "$dir/app"
  mkdir -p "$dir/gen"
  cp "$SNAILS_ROOT/scaffold/seed/gen/"*.rb "$dir/gen/"

  # Project template: `scaffold/new/**` is copied wholesale — config, the
  # bin/ wrappers, spin.toml, pins.toml — so the template stays the single
  # visible source of what `new` stamps. The compile root's basename is
  # the app name, which is also spin's build target and binary name. The
  # server entry is scaffold-owned (scaffold/main.rb — verify-scaffold
  # byte-compares it); app Main overrides go to config/environment.rb,
  # the boot chain's last require.
  cp "$SNAILS_ROOT/scaffold/main.rb" "$dir/main.rb"
  cp -R "$SNAILS_ROOT/scaffold/new/." "$dir/"
  mv "$dir/bin/__APP_NAME__.rb" "$dir/bin/${name}.rb"
  # The wrappers ship executable; cp masks the mode with the ambient
  # umask, so re-assert it.
  chmod +x "$dir/bin/test" "$dir/bin/dev" "$dir/bin/build-image" "$dir/bin/build-binary" "$dir/bin/compose"

  # The require-all generator is a CLI engine (`bin/snails gen-require-all`):
  # gen/* carries the `# scan:` specs, and the CLI turns them into the
  # literal require lists spinel's AOT graph needs. The app tree carries no
  # copy of it — a copy drifts from the core engine.
  # (Previously stamped into <dir>/scripts/; bin/test·bin/dev call the CLI.)

  # Values for the pins.toml template: the core release this project was
  # generated from and the spinel rev that release declares it was
  # validated with. An installed dist names its release version — the pin
  # must name published content, and a version is the release channel. An
  # unversioned dist falls back to its packaged rev, and a dev checkout
  # resolves HEAD (both are the edge channel). `snails verify-pins` later
  # checks the spinel pair against the pinned rev's declaration.
  local core_rev spinel_rev core_source core_version=""
  ((DIST_MODE)) && core_version="$(dist_own_version)"
  if pins_rev_is_version "$core_version"; then
    core_rev="$core_version"
  elif [[ -f $SNAILS_ROOT/REV ]]; then
    core_rev="$(<"$SNAILS_ROOT/REV")"
  elif git -C "$SNAILS_ROOT" rev-parse HEAD >/dev/null 2>&1; then
    core_rev="$(git -C "$SNAILS_ROOT" rev-parse HEAD)"
  else
    echo "[snails] cannot resolve the core rev: no REV file and no git checkout at $SNAILS_ROOT" >&2
    exit 1
  fi
  if ! pins_rev_is_version "$core_rev" && [[ ! $core_rev =~ ^[0-9a-f]{7,40}$ ]]; then
    echo "[snails] invalid core pin: $core_rev — expected a vX.Y.Z release or a full hex rev" >&2
    exit 1
  fi
  # A dist is a released source; a checkout is the development working
  # tree. The app declares which one it was created from, and sync/harness
  # read that declaration instead of guessing from the CLI or a dirty tree.
  if ((DIST_MODE)); then
    core_source="pin"
  else
    core_source="checkout"
  fi
  spinel_rev="$(pins_get "$SNAILS_ROOT/pins.toml" SPINEL_REV)"
  if [[ ! $spinel_rev =~ ^[0-9a-f]{4,40}$ ]]; then
    echo "[snails] $SNAILS_ROOT/pins.toml: SPINEL_REV is missing or not a hex rev: ${spinel_rev:-<unset>}" >&2
    exit 1
  fi

  # Stamp the template placeholders (the value side is literal — see
  # substitute_placeholder).
  substitute_placeholder "$dir/config/application.rb" __APP_NAME__ "$name"
  substitute_placeholder "$dir/config/database.rb" __DB_BACKEND__ "$database_backend"
  substitute_placeholder "$dir/bin/${name}.rb" __APP_NAME__ "$name"
  substitute_placeholder "$dir/pins.toml" __SPINEL_REV__ "$spinel_rev"
  substitute_placeholder "$dir/pins.toml" __SNALS_REV__ "$core_rev"
  substitute_placeholder "$dir/pins.toml" __SNALS_SOURCE__ "$core_source"
  substitute_placeholder "$dir/pins.toml" __APP_NAME__ "$name"

  # The image build follows the same DB adapter as config/database.rb: the
  # runtime package (the DB client — its CLI is also what the in-image
  # migration runner shells out to) and the sqlite volume/env are chosen
  # here, not guessed from the binary later. The compose example ships one
  # template per adapter; the selected file becomes compose.yml.
  case "$database_backend" in
    sqlite)
      substitute_placeholder "$dir/Dockerfile" __DB_PACKAGE__ "sqlite3"
      substitute_placeholder "$dir/Dockerfile" __DB_ENV__ "ENV DATABASE_PATH=/snails/storage/production.sqlite3"
      substitute_placeholder "$dir/Dockerfile" __DB_VOLUME__ "VOLUME /snails/storage"
      ;;
    postgresql)
      substitute_placeholder "$dir/Dockerfile" __DB_PACKAGE__ "postgresql-client"
      substitute_placeholder "$dir/Dockerfile" __DB_ENV__ "# PG_URL is provided by the deploy secret."
      substitute_placeholder "$dir/Dockerfile" __DB_VOLUME__ "# PostgreSQL: no app-owned volume; the database is external."
      ;;
  esac
  cp "$dir/compose.${database_adapter}.yml" "$dir/compose.yml"
  rm -f "$dir/compose.sqlite.yml" "$dir/compose.pg.yml"
  substitute_placeholder "$dir/compose.yml" __APP_NAME__ "$name"
  substitute_placeholder "$dir/compose.yml" __SPINEL_REV__ "$spinel_rev"
  substitute_placeholder "$dir/compose.yml" __SNALS_REV__ "$core_rev"
  substitute_placeholder "$dir/compose.yml" __DB_NAME__ "$db_name"

  # The pins file declares the source: a checkout-created app names the
  # checkout working tree, a dist-created app names the pin. The nested
  # sync reads that declaration, so `new` reflects local edits without a
  # separate flag and later syncs stay on the declared source. The nested
  # sync is an implementation step here: `new`'s ready block is the
  # result, so only its progress (stderr) passes through, not its
  # `synced` line.
  cmd_sync "$dir" >/dev/null

  # --scaffold: overlay the full API-mode template (posts + nested
  # comments JSON resources, harness CRUD cases) — after sync, so the
  # harness skeleton (boot.rb and the /up case) is seeded first and
  # the template only contributes its own case files there. It redefines
  # the minimal files it needs (main.rb, config/routes.rb, gen/models.rb,
  # gen/controllers.rb), so its versions win. `new` stamps the adapter's
  # DDL as the first migration under a UTC version and removes the
  # template's migration files. `db/schema.sql` is NOT written here — it
  # is `migrate dump`'s output, generated by the explicit command
  # printed below.
  if ((full)); then
    cp -R "$SNAILS_ROOT/scaffold/full/." "$dir/"
    local baseline_version
    baseline_version="$(date -u +%Y%m%d%H%M%S)"
    cp "$dir/db/migrate/0001_baseline.${database_adapter}.sql" \
      "$dir/db/migrate/${baseline_version}_baseline.sql"
    rm "$dir/db/migrate/0001_baseline.sqlite.sql" \
      "$dir/db/migrate/0001_baseline.pg.sql"
  fi

  # Path helpers: derived from the route table, which is final here (the
  # --scaffold overlay replaced config/routes.rb). The boot chain requires
  # the file, so generate it before the first boot (sync already
  # seeded a placeholder).
  bash "$SNAILS_ROOT/cli/gen-route-helpers.sh" "$dir" >/dev/null
  # Model columns: generated from the snapshot, which only the explicit
  # `migrate dump` writes. A fresh tree has none yet, so this stays a no-op
  # and the first build names the dump repair.
  if [[ -f $dir/db/schema.sql ]]; then
    bash "$SNAILS_ROOT/cli/gen-model-columns.sh" "$dir" >/dev/null
  fi

  if ((full)); then
    echo "[snails] created $dir (GET /up + posts + comments API)"
  else
    echo "[snails] created $dir (GET /up)"
  fi
  echo "  cd $dir"
  if ((full)); then
    echo "  snails migrate apply  provision the development database"
    echo "  snails migrate dump   generate db/schema.sql from the migrations"
  fi
  echo "  bin/dev          start the development server"
  echo "  bin/test         run the test suite"
  echo "  bin/build-image  build the app image"
  echo "  bin/compose      deploy with Docker Compose (compose.yml)"
  if [[ $database_backend == "postgresql" ]]; then
    echo "  database         postgresql (bin/dev starts a dev container or uses PG_URL)"
  else
    echo "  database         sqlite (storage/development.sqlite3)"
  fi
}

cmd_verify_pin() {
  local arg="" verbose=0
  while (($#)); do
    case "$1" in
      --verbose) verbose=1; shift ;;
      -h|--help) help_for verify-pin; exit 0 ;;
      -*) echo "[snails] unknown flag: $1" >&2; exit 2 ;;
      *)
        if [[ -n $arg ]]; then
          echo "[snails] usage: snails verify-pin [rev|pins.toml] [--verbose]" >&2
          exit 2
        fi
        arg="$1"; shift
        ;;
    esac
  done
  if [[ -z $arg ]]; then
    # No argument: the pins file in the current directory (the app root).
    if [[ -f pins.toml ]]; then
      arg="pins.toml"
    fi
  fi
  [[ -n $arg ]] || { echo "[snails] usage: snails verify-pin [rev|pins.toml] [--verbose]" >&2; exit 2; }
  local rev="$arg"
  if [[ -f $arg ]]; then
    rev="$(pins_rev "$arg")"
    [[ -n $rev ]] || { echo "[snails] SNALS_REV unset in $arg" >&2; exit 1; }
    # A declared pin (full rev or vX.Y.Z version) resolves to its full
    # rev — the same read rule sync and verify-pins apply.
    rev="$(resolve_pin_rev "$rev" "$arg")" || exit 1
  fi
  if ((DIST_MODE)); then
    verify_pin_dist "$rev"
  elif ((verbose)); then
    bash "$SNAILS_ROOT/cli/verify-pin.sh" "$rev" --verbose
  else
    bash "$SNAILS_ROOT/cli/verify-pin.sh" "$rev"
  fi
}

# pins_file_or_fail <dir> — the pins file at or above <dir>, or one line
# and exit 1. The declaration gate and pins-path refuse the same way, so
# the walk and the refusal stay in one place. The result ends in a
# newline (a command substitution strips it, a terminal needs it).
pins_file_or_fail() {
  local dir="$1" pins
  pins="$(pins_discover "$dir")"
  if [[ -z $pins ]]; then
    echo "[snails] no pins file at or above $dir — add pins.toml (snails new stamps one)" >&2
    exit 1
  fi
  printf '%s\n' "$pins"
}

# pins-path [<app_root>] — print where the pins file is. The path is the
# result, so stdout carries that one line and nothing else; a caller that
# has to find the pins file before snails is installed (a CI bootstrap)
# is not served by this command — the walk itself is cli/pins.sh's.
cmd_pins_path() {
  local dir="" given=0
  while (($#)); do
    case "$1" in
      -h|--help) help_for pins-path; exit 0 ;;
      -*) echo "[snails] unknown flag: $1" >&2; exit 2 ;;
      *) dir="$1"; given=1; shift ;;
    esac
  done
  # The pins file sits at the app root, so pins-path resolves the app root
  # the same way every other command does. An explicit argument may be the
  # repository root of a src/ layout; an omitted one may be that root too.
  if ((given)); then
    dir="$(app_root_for "$dir")"
  else
    dir="$(resolve_app_root '[snails]' '<app_root>')" || exit 2
  fi
  pins_file_or_fail "$dir"
}

cmd_verify_pins() {
  local app_root="." pins="" errors=() arg out verbose=0 app_root_given=0
  while (($#)); do
    case "$1" in
      --pins) pins="${2:-}"; shift 2 ;;
      --verbose) verbose=1; shift ;;
      -h|--help) help_for verify-pins; exit 0 ;;
      -*) echo "[snails] unknown flag: $1" >&2; exit 2 ;;
      *) app_root="$1"; app_root_given=1; shift ;;
    esac
  done

  # The pins file sits at the app root, so the declaration gate resolves the
  # app root the same way every other command does: an explicit argument
  # through app_root_for (including the src/ layout), an omitted one through
  # resolve_app_root (including the repository root of the src/ layout).
  if [[ -n $pins ]]; then
    [[ -f $pins ]] || { echo "[snails] no such pins file: $pins" >&2; exit 1; }
  else
    if ((app_root_given)); then
      app_root="$(app_root_for "$app_root")"
    else
      app_root="$(resolve_app_root '[snails]' '<app_root>')" || exit 2
    fi
    pins="$(pins_file_or_fail "$app_root")" || exit 1
  fi

  # The two halves of the pin contract: SNALS_REV must point at a
  # restorable core rev, and SPINEL_REV must equal the rev that rev
  # itself declares — validation is a property of the (core rev, spinel
  # rev) pair, so the check reads the PINNED rev's record, never this
  # tree's current value (an old pair stays valid under a newer CLI).
  # A declared pin (full rev or vX.Y.Z version) resolves to its full
  # rev first; errors keep naming the declared value the user wrote.
  local snals_rev spinel_rev snals_source snals_ok=0 declared="" rc=0 snals_resolved=""
  snals_rev="$(pins_rev "$pins")"
  spinel_rev="$(pins_get "$pins" SPINEL_REV)"
  snals_source="$(pins_get "$pins" SNALS_SOURCE)" || snals_source=""
  if [[ -n $snals_source && $snals_source != "pin" && $snals_source != "checkout" ]]; then
    errors+=("SNALS_SOURCE must be \"pin\" or \"checkout\", got: $snals_source")
  fi

  if [[ -z $snals_rev ]]; then
    errors+=("SNALS_REV is not declared")
  elif ! snals_resolved="$(resolve_pin_rev "$snals_rev" "$pins" 2>&1)"; then
    errors+=("$(printf '%s' "$snals_resolved" | tail -n1 | sed 's/^\[snails\] //')")
  elif ((DIST_MODE)); then
    if out="$(verify_pin_dist "$snals_resolved" 2>&1)"; then
      snals_ok=1
    else
      errors+=("SNALS_REV($snals_rev): $(printf '%s' "$out" | tail -n1)")
    fi
  else
    # --verbose reaches the engine's pin notice (the commit list behind it).
    local verify_pin_args=("$snals_resolved")
    if ((verbose)); then
      verify_pin_args+=(--verbose)
    fi
    if out="$(bash "$SNAILS_ROOT/cli/verify-pin.sh" "${verify_pin_args[@]}" 2>&1)"; then
      snals_ok=1
      # The checkout being ahead of the pin is core-developer information;
      # the default pin check is one result line. --verbose passes the
      # notice (and its commit list) through.
      if ((verbose)); then
        [[ -z $out ]] || printf '%s\n' "$out"
      fi
    else
      errors+=("SNALS_REV($snals_rev): $(printf '%s' "$out" | tail -n1)")
    fi
  fi

  if [[ -z $spinel_rev ]]; then
    errors+=("SPINEL_REV is not declared")
  elif ((snals_ok)); then
    if ((DIST_MODE)); then
      declared="$(declared_spinel_dist "$snals_resolved")" || rc=$?
    else
      declared="$(declared_spinel_checkout "$snals_resolved")" || rc=$?
    fi
    if ((rc == 2)); then
      errors+=("SNALS_REV($snals_rev): the pinned rev's spinel declaration could not be read (not this dist's rev, not cached, fetch failed) — run verify-pins from a snails checkout, or verify with the dist of that rev")
    elif [[ -z $declared ]]; then
      errors+=("SNALS_REV($snals_rev) carries no spinel pin declaration (SPINEL_REV) — bump it to a rev that declares one")
    elif [[ $spinel_rev != "$declared" ]]; then
      # The repair line embeds the sync target only when the caller named
      # one — a --pins-only call (consumer CI) has no spin root to guess.
      if ((app_root_given)); then
        local repair_arg sync_command
        repair_arg="$(app_root_argument "$app_root")"
        sync_command="snails sync"
        [[ -n $repair_arg ]] && sync_command+=" $(shell_quote "$repair_arg")"
        errors+=("SPINEL_REV($spinel_rev) is not the rev declared for SNALS_REV($snals_rev) ($declared) — set SPINEL_REV=\"$declared\" in $pins and run: $sync_command")
      else
        errors+=("SPINEL_REV($spinel_rev) is not the rev declared for SNALS_REV($snals_rev) ($declared) — set SPINEL_REV=\"$declared\" in $pins, then sync the app tree that pins it")
      fi
    fi
  fi

  if ((${#errors[@]})); then
    echo "[snails] $pins violates the pin declaration:" >&2
    local e
    for e in ${errors[@]+"${errors[@]}"}; do
      echo "  - $e" >&2
    done
    exit 1
  fi
  # The ok line names what the user declared — a version stays whole, a
  # rev keeps the 7-char label.
  local snals_label="$snals_rev"
  if pins_rev_is_full "$snals_rev"; then
    snals_label="${snals_rev:0:7}"
  fi
  echo "[snails] pins ok (spinel=$spinel_rev snails=$snals_label)"
}

cmd_verify_scaffold() {
  local app="${1:-}"
  if [[ ${1:-} == -h || ${1:-} == --help ]]; then
    help_for verify-scaffold
    exit 0
  fi
  if [[ -z $app ]]; then
    app="$(resolve_app_root '[snails]' '<app_root>')" || exit 2
  else
    # An explicit argument may be the repository root of a src/ layout; the
    # omitted case resolves the same root through resolve_app_root.
    app="$(app_root_for "$app")"
  fi
  bash "$SNAILS_ROOT/cli/verify-scaffold.sh" "$app"
}

