  cat <<'HELP'
Usage: snails version

Show the CLI version and revision.
HELP
}

help_harness() {
  cat <<'HELP'
Usage: snails harness <test|dev> [<app_root>] [options]

Internal runner used by the generated bin/test and bin/dev scripts.
Run bin/test or bin/dev from an app root instead of calling this directly.
HELP
}

help_harness_runner() {
  case "$1" in
    test)
      cat <<'HELP'
Usage: snails harness test [<app_root>] [--force] [--verbose] [-- <case>...]

Internal test gate used by bin/test. Builds the app, boots it on a spare
port, and runs the harness cases. Unknown case names fail; they never
widen to the whole suite.
HELP
      ;;
    dev)
      cat <<'HELP'
Usage: snails harness dev [<app_root>] [--force] [--skip-build] [--fresh] [--verbose] [-- <binary args>]

Internal development server used by bin/dev. Builds the app and serves it
in the foreground.
HELP
      ;;
    *)
      return 1
      ;;
  esac
}

