module ActionController
  class API
    def params: () -> Hash[String, untyped]
    def params=: (Hash[String, untyped]) -> Hash[String, untyped]
    def request_method: () -> String
    def request_method=: (String) -> String
    def request_path: () -> String
    def request_path=: (String) -> String
    def request_format: () -> Symbol
    def request_format=: (Symbol) -> Symbol
    def accepts_any_format: () -> bool
    def accepts_any_format=: (bool) -> bool
    def path_parameters: () -> Hash[String, String]
    def path_parameters=: (Hash[String, String]) -> Hash[String, String]
    def action_name: () -> Symbol?
    def action_name=: (Symbol?) -> Symbol?

    def status: () -> Integer
    def body: () -> String
    def location: () -> String?
    def content_type: () -> String

    def performed?: () -> bool

    def initialize: () -> void

    def self.before_action: (*Symbol names, ?only: (Symbol | Array[Symbol])?, ?except: (Symbol | Array[Symbol])?) -> void
    def run_before_filters: () -> void
    def filter_applies?: (Array[Symbol] only_list, Array[Symbol] except_list) -> bool

    def process_action: (Symbol action_name) -> void
    def send_action: (Symbol action_name) -> void
    def default_render: () -> void

    def render: (
      ?String body,
      ?status: Symbol | Integer,
      ?content_type: String?,
      ?location: String?,
      ?json: untyped
    ) -> void

    def redirect_to: (String path, ?status: Symbol | Integer) -> void

    def head: (Symbol | Integer status, ?content_type: String?, ?location: String?) -> void
    def response: () -> API
    def fresh_when: (untyped subject) -> void
    def stale?: (?etag: untyped) -> bool
    def expires_in: (Integer seconds, ?public: bool, ?stale_while_revalidate: Integer) -> void
    def cache_control_max_age: () -> Integer
    def cache_control_public: () -> bool
    def headers: () -> Hash[String, String]
    def send_data: (String data, ?type: String, ?disposition: String) -> void

    def resolve_status: (Symbol | Integer s) -> Integer
  end
end
