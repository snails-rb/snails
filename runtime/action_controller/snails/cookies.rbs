module ActionController
  class Cookie
    attr_reader name: String
    attr_reader value: String
    attr_reader options: Hash[String, String]

    def initialize: (String name, String value, Hash[String, String] options) -> void
  end

  class CookieJar
    @inbound: Hash[String, String]
    @writes: Array[ActionController::Cookie]

    def initialize: (?Hash[String, String] inbound) -> void
    def []: (untyped key) -> String
    def []=: (untyped key, untyped value) -> String
    def write_from: (untyped key, untyped value, bool permanent) -> String
    def permanent: () -> ActionController::PermanentCookieJar
    def signed: () -> ActionController::SignedCookieJar
    def raw: (untyped key) -> String
    def raw_set: (untyped key, untyped value, ?Hash[Symbol, untyped] options, ?bool permanent) -> String
    def delete: (untyped key, **untyped options) -> String
    def pending: () -> Array[ActionController::Cookie]
    def to_h: () -> Hash[String, String]
    def each: () { (String, String) -> void } -> ActionController::CookieJar

    private def canonical_options: (String name, Hash[Symbol, untyped] options, bool permanent) -> Hash[String, String]
    private def cookie_name: (untyped key) -> String
    private def cookie_name_byte?: (Integer byte) -> bool
    private def path_value: (untyped value) -> String
    private def domain_value: (untyped value) -> String
    private def domain_byte?: (Integer byte) -> bool
    private def boolean_value: (untyped value, Symbol name) -> bool
    private def same_site_value: (untyped value) -> String
    private def expires_value: (untyped value) -> String
    private def max_age_value: (untyped value) -> Integer
    private def http_date: (Time value) -> String
    private def pad_number: (Integer value) -> String
  end

  class PermanentCookieJar
    @jar: ActionController::CookieJar

    def initialize: (ActionController::CookieJar jar) -> void
    def []: (untyped key) -> String
    def []=: (untyped key, untyped value) -> String
    def delete: (untyped key, **untyped options) -> String
  end

  class SignedCookieJar
    @jar: ActionController::CookieJar

    def initialize: (ActionController::CookieJar jar) -> void
    def []: (untyped key) -> String?
    def []=: (untyped key, untyped value) -> String
    def write_from: (untyped key, untyped value, bool permanent) -> String
    def permanent: () -> ActionController::SignedPermanentCookieJar
    def delete: (untyped key, **untyped options) -> String

    private def verifier: () -> Snails::MessageVerifier
    private def cookie_secret: () -> String
    private def purpose_for: (untyped key) -> String
  end

  class SignedPermanentCookieJar
    @signed: ActionController::SignedCookieJar

    def initialize: (ActionController::SignedCookieJar signed) -> void
    def []: (untyped key) -> String?
    def []=: (untyped key, untyped value) -> String
    def delete: (untyped key, **untyped options) -> String
  end

  class API
    def cookies: () -> ActionController::CookieJar
    def cookies=: (ActionController::CookieJar value) -> ActionController::CookieJar
  end
end
