module ActionMailer
  class Message
    @to: untyped
    @from: untyped
    @replyto: untyped
    @subject: untyped
    @body: untyped

    def initialize: (Hash[Symbol, untyped] opts) -> void
    def to: () -> untyped
    def from: () -> untyped
    def replyto: () -> untyped
    def subject: () -> untyped
    def body: () -> untyped
    def deliver_now: () -> Message
    def deliver_later: () -> Message
  end
end
