module Snails
  class QueueJob < Sqlx::Base
    COLUMNS: Array[String]

    attr_reader id: Integer
    attr_reader name: String
    attr_reader payload: untyped
    attr_reader status: String
    attr_reader scheduled_at: Time?
    attr_reader started_at: Time?
    attr_reader finished_at: Time?
    attr_reader attempts: Integer
    attr_reader last_error: String?
    attr_reader created_at: Time?
    attr_reader updated_at: Time?

    def self.enqueue!: (String name, untyped? payload, Time scheduled_at, Time now) -> void
    def self.claim_due: (Time now) -> Snails::QueueJob?
    def self.release_orphaned!: (Time started_before, Time now) -> Integer
    def self.mark_succeeded!: (untyped id, Time now) -> void
    def self.mark_failed!: (untyped id, String error, Time now) -> void
    def self.prune_finished!: (Time finished_before, limit: Integer) -> Integer
  end
end
