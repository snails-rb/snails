module Snails
  class Logger
    class Record
      SEVERITIES: Array[Symbol]
      SCHEMA_VERSION: Integer
      RESERVED_FIELDS: Array[String]
      TRACE_FIELDS: Array[String]
      TRACE_ID_PATTERN: Regexp
      SPAN_ID_PATTERN: Regexp
      ZERO_TRACE_ID: String
      ZERO_SPAN_ID: String
      MAX_TRACE_FLAGS: Integer

      def initialize: (
        Symbol severity,
        String event,
        String body,
        ?fields: Hash[untyped, untyped],
        ?exception: Exception?,
        ?time: Time?,
        ?context: Hash[String, untyped],
        ?resource: Hash[String, untyped],
        ?trace: Hash[untyped, untyped]?
      ) -> void

      def severity: () -> Symbol
      def event: () -> String
      def body: () -> String
      def fields: () -> Hash[String, untyped]
      def resource: () -> Hash[String, untyped]
      def trace_id: () -> String?
      def span_id: () -> String?
      def trace_flags: () -> Integer?
      def exception: () -> Exception?
      def time: () -> Time
      def exception_type: () -> String?
      def exception_message: () -> String?
      def exception_stacktrace: () -> String?
    end
  end
end
