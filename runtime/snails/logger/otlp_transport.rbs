module Snails
  class Logger
    class OTLPTransport
      OPEN_TIMEOUT: Integer
      READ_TIMEOUT: Integer
      MAX_ATTEMPTS: Integer

      class DeliveryError < StandardError
        @status: Integer?

        def initialize: (String message, ?Integer? status) -> void
        def status: () -> Integer?
      end

      @endpoint: String
      @token: String
      @uri: untyped
      @executor_warned: bool
      @session: untyped
      @session_lock: Mutex

      def initialize: (endpoint: String, token: String) -> void
      def after_fork: () -> void
      def deliver: (Array[Record] records) -> void
      def send_encoded: (untyped body) -> bool
    end
  end
end
