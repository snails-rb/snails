module Snails
  def self.env: () -> Env
  def self.env=: (String? name) -> Env

  class Env
    @name: String

    def initialize: (String name) -> void
    def name: () -> String
    def development?: () -> bool
    def production?: () -> bool
    def test?: () -> bool
    def staging?: () -> bool
  end
end
