module Snails
  class CronExpression
    @expression: String
    @minutes: Array[Integer]
    @hours: Array[Integer]
    @days: Array[Integer]
    @months: Array[Integer]
    @wdays: Array[Integer]
    @days_restricted: bool
    @wdays_restricted: bool

    def self.parse: (String expression) -> CronExpression

    def occurrence_at_or_before: (Integer now) -> Integer
    def occurrence_after: (Integer now) -> Integer
  end
end
