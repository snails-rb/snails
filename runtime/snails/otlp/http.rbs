module Snails
  module OTLP
    class DeliveryError < StandardError
      @status: Integer?

      def initialize: (String message, ?Integer? status) -> void
      def status: () -> Integer?
    end

    class HTTP
      OPEN_TIMEOUT: Integer
      READ_TIMEOUT: Integer
      MAX_ATTEMPTS: Integer

      @token: String
      @uri: untyped
      @session: untyped
      @session_lock: Mutex

      def initialize: (endpoint: String, token: String, path: String) -> void
      def url: () -> untyped
      def after_fork: () -> void
      def send_encoded: (untyped body) -> bool
    end
  end
end
